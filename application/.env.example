# Devboard Local Environment Variables
# Copy this file to .env and fill in your passwords before running `docker compose up`

# -------------------------
# Database Passwords
# -------------------------
POSTGRES_USER=devboard_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=devboard_core

MONGO_INITDB_ROOT_USERNAME=devboard_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here

# -------------------------
# Backend Connections
# -------------------------
DATABASE_URL=postgresql://devboard_admin:your_secure_password_here@postgres:5432/devboard_core
MONGO_URL=mongodb://devboard_admin:your_secure_password_here@mongodb:27017/?authSource=admin

# -------------------------
# Security
# -------------------------
JWT_SECRET_KEY=generate_a_random_string_here
